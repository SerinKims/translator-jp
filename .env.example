PIXIV_FETCH_ENABLED=true
PIXIV_FETCH_TIMEOUT_SECONDS=30
PIXIV_FETCH_MIN_INTERVAL_SECONDS=3
PIXIV_FETCH_MAX_RETRIES=2
PIXIV_USE_PLAYWRIGHT=false
